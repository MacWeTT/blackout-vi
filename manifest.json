{
  "manifest_version": 3,
  "name": "GTA VI Spoiler Shield",
  "version": "0.1.0",
  "description": "Hides GTA VI story and gameplay spoilers on YouTube, X and Reddit before they ever paint.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GTA VI Spoiler Shield",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/images/background.jpg", "assets/images/gta-vi-logo.png"],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": [
        "src/core/wordlists.js",
        "src/core/classifier.js",
        "src/core/trust.js",
        "src/content/engine.js",
        "src/content/youtube.js"
      ],
      "css": ["src/content/shared.css", "src/content/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "src/core/wordlists.js",
        "src/core/classifier.js",
        "src/core/trust.js",
        "src/content/engine.js",
        "src/content/x.js"
      ],
      "css": ["src/content/shared.css", "src/content/x.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://reddit.com/*"],
      "js": [
        "src/core/wordlists.js",
        "src/core/classifier.js",
        "src/core/trust.js",
        "src/content/engine.js",
        "src/content/reddit.js"
      ],
      "css": ["src/content/shared.css", "src/content/reddit.css"],
      "run_at": "document_start"
    }
  ]
}
