{
  "manifest_version": 3,
  "name": "GTA VI Spoiler Shield",
  "version": "0.1.0",
  "description": "Hides GTA VI story and gameplay spoilers on YouTube before they ever paint.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GTA VI Spoiler Shield",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/images/background.jpg", "assets/images/gta-vi-logo.png"],
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/core/wordlists.js", "src/core/classifier.js", "src/core/trust.js", "src/content/youtube.js"],
      "css": ["src/content/youtube.css"],
      "run_at": "document_start"
    }
  ]
}
